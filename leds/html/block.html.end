<script>
function updateClock() {
  now = new Date().toLocaleTimeString('it-IT', {hour: '2-digit', minute: '2-digit'});
  document.getElementById('clock').innerHTML = now.toString();
}
updateClock();
setInterval(updateClock, 20000);
</script>
